# ===========================================================================
# ClassyFire Batch Web — Environment Variables (Appendix A)
# ===========================================================================
# Copy this file to `.env` and fill in values before running locally or in
# production.  Values shown are the defaults used when a variable is absent.
#
# PRODUCTION: DJANGO_SECRET_KEY, POSTGRES_PASSWORD, NGROK_DOMAIN, and
# SHARED_ACCESS_PASSWORD_HASH are REQUIRED — the app will refuse to start
# without them.  All others have safe defaults but should be reviewed.
# ===========================================================================

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Required in production; dev default accepts anything non-empty.
DJANGO_SECRET_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=classyfire
POSTGRES_USER=classyfire
# Required in production.
POSTGRES_PASSWORD=
# Docker Compose service name; override to 127.0.0.1 for local-dev.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Ngrok tunnel
# ---------------------------------------------------------------------------
# Obtain from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Auto-assigned Dev Domain from ngrok dashboard; required in production.
NGROK_DOMAIN=

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# FULL | LITE | CUSTOM
SEED_PROFILE=FULL
SEED_RECORD_ID=20472700
SEED_AUTO_UPDATE=false

# ---------------------------------------------------------------------------
# ClassyFire remote API
# ---------------------------------------------------------------------------
WISHART_BASE_URL=http://classyfire.wishartlab.com
REMOTE_ENABLED=true
# REMOTE_ENTITY_REQUESTS_PER_MIN and REMOTE_SUBMITS_PER_MIN are intentionally NOT
# here: Wishart rate-limits per IP (GET ~10/min, POST ~12/min), so both are
# hard-coded (NOT env-overridable) in config/settings/base.py.
# REMOTE_BATCH_SIZE is intentionally NOT here either: the effective batch is
# clamped to Wishart's JSON page size (10 compounds/page) in the worker, so
# exposing it as a tunable would be misleading.
# Minimum seconds between status-poll requests per job
REMOTE_POLL_MIN_SECONDS=60
REMOTE_MAX_CONCURRENCY=2
REMOTE_TIMEOUT_SECONDS=45
# Upper bound for accepted provider Retry-After hints (hard-capped at 24 hours)
WISHART_MAX_RETRY_AFTER_SECONDS=86400
# Give-up horizon (hours) for a stuck remote task. An exhausted task otherwise
# retries ~daily forever, pinning its job to IN_PROGRESS. After this many hours
# the worker marks it done and its items become REMOTE_TIMED_OUT so the job can
# complete. 0 disables. Manual lever: `manage.py reap_stale_remote_tasks`.
REMOTE_DELAYED_TIMEOUT_HOURS=24
# Structure resolution: auto-fetch a structure for NEED_STRUCTURE items (InChIKey
# missed local + Wishart caches) from public key-free DBs, verify it re-hashes to
# the same InChIKey, and auto-submit for calculation. Strictly additive. Ordered,
# comma-separated provider chain (key-free): pubchem, cactus. Per-provider polite
# rates are hard-coded (smooth, well under each service's limits). Set ENABLED
# false to disable; manual sweep: `manage.py resolve_structures`.
STRUCTURE_RESOLVE_ENABLED=true
STRUCTURE_RESOLVE_PROVIDERS=pubchem,cactus
STRUCTURE_RESOLVE_TIMEOUT_SECONDS=15
# Max distinct InChIKeys scanned per sweep (per-provider rate limiter bounds the
# actual outbound calls; cached misses are skipped cheaply).
STRUCTURE_RESOLVE_SWEEP_LIMIT=200
# Cache a compound that's in NO public DB this long (seconds) so it isn't
# re-queried every sweep. Transient (rate-limited) skips are never cached.
STRUCTURE_RESOLVE_MISS_TTL_SECONDS=21600
# -1 disables per-principal remote budget enforcement.
REMOTE_DAILY_BUDGET_PER_PRINCIPAL=-1

# ---------------------------------------------------------------------------
# Upload / retention
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=100
UPLOAD_RETAINED_BYTES_PER_PRINCIPAL=524288000
UPLOAD_RETAINED_BYTES_GLOBAL=2147483648
UPLOAD_RETENTION_DAYS=30
# Completed/failed jobs are deleted this many days after completion. Their
# uploaded input file, export files, and result page go away; the InChIKey↔
# structure SQL and the classification cache are NOT touched.
JOB_RETENTION_DAYS=7
# Generated export files (CSV/TSV/JSON) expire this many days after creation.
EXPORT_RETENTION_DAYS=7
# Pause new uploads when disk usage exceeds this percentage
DISK_UPLOAD_PAUSE_PERCENT=85
MAX_ROWS_PER_JOB=10000
# F-11: route-level async ingest (default: true).  Set to false only in
# service-level tests or diagnostics that need the synchronous pipeline.
INGEST_DEFER_HEAVY_PROCESSING=true
JOB_CREATE_RATE_LIMIT_PER_MINUTE=30
JOB_CREATE_DAILY_ROW_CAP=100000
ACTIVE_JOB_CAP=20
EXPORT_CREATE_RATE_LIMIT_PER_MINUTE=10
JOB_ACCESS_COOKIE_DAYS=14
AUDIT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Shared-access gate
# ---------------------------------------------------------------------------
# Django password hash of the shared-access password.
# Generate with: python manage.py shell -c "from django.contrib.auth.hashers import make_password; print(make_password('yourpassword'))"
# Required in production.
SHARED_ACCESS_PASSWORD_HASH=
SHARED_ACCESS_LOGIN_FAILURE_LIMIT=5
SHARED_ACCESS_LOGIN_FAILURE_WINDOW_SECONDS=300
SHARED_ACCESS_LOGIN_GLOBAL_MAX_FAILURES=50
SHARED_ACCESS_LOGIN_GLOBAL_WINDOW_SECONDS=300
