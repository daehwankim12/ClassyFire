# =============================================================================
# ClassyFire Batch Web — Caddyfile
#
# Caddy acts as the reverse proxy sitting in front of the Gunicorn `web`
# container. Public TLS is terminated by ngrok; Caddy receives internal HTTP
# and forwards `X-Forwarded-Proto: https` so Django applies secure-cookie and
# HTTPS-only behavior correctly.
#
# Environment variables available at Caddyfile parse time via `{$VAR}` syntax:
#   NGROK_DOMAIN  — the public hostname (e.g. myapp.ngrok-free.app)
#   MAX_UPLOAD_MB — maximum body size for file uploads; defaults to 100
# =============================================================================

{
    servers {
        # The ngrok agent shares this container's network namespace and reaches
        # Caddy over IPv4 loopback. Trust no other Compose peer's forwarding
        # headers, and parse right-to-left so a client-supplied leftmost value
        # cannot replace the address appended by ngrok.
        trusted_proxies static 127.0.0.1/32
        trusted_proxies_strict
        client_ip_headers X-Forwarded-For
    }
}

http://{$NGROK_DOMAIN} {

    # ── Upload size limit ────────────────────────────────────────────────────
    # MAX_UPLOAD_MB defaults to 100 when the env var is unset.
    request_body {
        max_size {$MAX_UPLOAD_MB:100}mb
    }

    # ── Security headers ─────────────────────────────────────────────────────
    header {
        # Prevent browsers from MIME-sniffing
        X-Content-Type-Options "nosniff"
        # Clickjacking protection
        X-Frame-Options "DENY"
        # Cross-site scripting filter (legacy browsers)
        X-XSS-Protection "1; mode=block"
        # HSTS: 1 year, include subdomains, allow preload
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Referrer policy — strict-origin trims the Referer to the origin only
        # (no path), so the per-job secret embedded in a URL path never appears
        # in any Referer header, while keeping a valid Origin header. ("no-referrer"
        # makes browsers send "Origin: null" on POSTs, which breaks Django CSRF.)
        Referrer-Policy "strict-origin"
        # Content-Security-Policy — tightened in Task 11
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
        # Remove server identification headers
        -Server
        -X-Powered-By
    }

    # ── Reverse proxy to Gunicorn ────────────────────────────────────────────
    reverse_proxy web:8000 {
        # Forward only Caddy's sanitized client identity, not the untrusted
        # inbound forwarding chain. Django uses this value for IP throttles.
        header_up X-Forwarded-For {http.request.client_ip}
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {http.request.client_ip}
        header_up Host {host}

        # Health-check: mark upstream as unhealthy after 3 consecutive failures
        health_uri /health/
        health_interval 30s
        health_timeout 5s
        health_status 200
        health_headers {
            Host {$NGROK_DOMAIN}
            X-Forwarded-Proto https
        }
    }

    # Claim and legacy result/structure URLs carry one-time job secrets. Do
    # not write those raw paths to Caddy access logs; Django immediately
    # exchanges them for an HttpOnly cookie and redirects to secretless URLs.
    @jobClaimSecret path_regexp job_claim_secret ^/jobs/[^/]+/claim/[^/]+/?$
    log_skip @jobClaimSecret
    @jobLegacySecret path_regexp job_legacy_secret ^/jobs/[^/]+/[^/]+/?$
    log_skip @jobLegacySecret
    @jobLegacyItemsSecret path_regexp job_legacy_items_secret ^/jobs/[^/]+/[^/]+/items/?$
    log_skip @jobLegacyItemsSecret
    @jobLegacyProgressSecret path_regexp job_legacy_progress_secret ^/jobs/[^/]+/[^/]+/progress/?$
    log_skip @jobLegacyProgressSecret
    @itemLegacyStructureSecret path_regexp item_legacy_structure_secret ^/items/[0-9]+/[^/]+/structure/?$
    log_skip @itemLegacyStructureSecret

    # ── Serve collected static files directly ────────────────────────────────
    # Mount the same volume that `web` writes staticfiles into.
    handle_path /static/* {
        root * /app/staticfiles
        file_server {
            # Let Caddy set cache headers for static assets
            precompressed gzip br
        }
    }

    # ── Skip logging for requests that contain secrets in URL ────────────────
    # Reject residual ?secret= query params at the proxy layer — these should
    # now return HTTP 400 from Django, but we also skip logging the URL so the
    # plaintext secret never appears in Caddy access logs.
    @apiQuerySecret expression `{query.secret} != ""`
    log_skip @apiQuerySecret
    @apiExportToken path_regexp api_export_token ^/api/exports/[^/]+/?$
    log_skip @apiExportToken

    # ── Logging ──────────────────────────────────────────────────────────────
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Authorization delete
                request>headers>Cookie delete
                request>headers>X-Job-Secret delete
                request>headers>X-Shared-Access-Token delete
            }
        }
        level INFO
    }
}
